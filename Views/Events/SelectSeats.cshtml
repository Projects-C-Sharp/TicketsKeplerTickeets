@model TicketsKeplerTickets.Models.ViewModels.SeatSelectionViewModel
@using TicketsKeplerTickets.Models.DTOs
@{
    ViewData["Title"] = "Seleccionar asientos — " + Model.Event.Name;

    var seatsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Seats,
        new System.Text.Json.JsonSerializerOptions
        {
            PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
        });

    var isAuth    = User.Identity?.IsAuthenticated == true;
    var basePrice = Model.Showtime.BasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture);

    var pending     = Model.PendingOrder;
    var hasPending  = pending != null;

    // Serialize pending order for JS (null-safe)
    var pendingJson = hasPending
        ? System.Text.Json.JsonSerializer.Serialize(pending,
            new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase })
        : "null";
}

@* ── Persistent pending-order banner (only this user sees it) ──────────── *@
@if (hasPending)
{
    <div class="pending-order-banner" id="pendingBanner">
        <div class="pending-banner-inner">
            <span class="pending-banner-icon">⚠️</span>
            <div class="pending-banner-text">
                <strong>Tienes una orden pendiente de pago</strong>
                <span>Orden #@pending!.Id.ToString("D5") · $@pending!.Total.ToString("N0") · @pending!.Items.Count asiento@(pending!.Items.Count != 1 ? "s" : "")</span>
            </div>
            <div class="pending-banner-actions">
                <button class="btn btn-primary btn-sm" id="resumePayBtn">
                    <span class="btn-label">💳 Pagar ahora</span>
                    <span class="btn-spinner hidden">⟳</span>
                </button>
                <button class="btn btn-danger btn-sm" id="resumeCancelBtn">
                    <span class="btn-label">✕ Cancelar orden</span>
                    <span class="btn-spinner hidden">⟳</span>
                </button>
            </div>
        </div>
    </div>
}

<section class="seat-page">
    <!-- Breadcrumb -->
    <div class="breadcrumb container">
        <a asp-controller="Events" asp-action="Index">Eventos</a>
        <span>›</span>
        <a asp-controller="Events" asp-action="Detail" asp-route-id="@Model.Event.Id">@Model.Event.Name</a>
        <span>›</span>
        <span>Seleccionar asientos</span>
    </div>

    @Html.AntiForgeryToken()

    <div class="seat-layout container">

        <!-- LEFT: Seat Map -->
        <div class="seat-map-panel">
            <div class="showtime-header">
                <h2 class="showtime-title">@Model.Event.Name</h2>
                <p class="showtime-meta">
                    🕐 @Model.Showtime.StartTime.ToString("dddd, dd 'de' MMMM yyyy · hh:mm tt", new System.Globalization.CultureInfo("es-CO"))
                </p>
                <p class="showtime-meta" style="font-size:.82rem; margin-top:.25rem">
                    @Model.Showtime.AvailableSeats de @Model.Showtime.TotalSeats asientos disponibles
                </p>
            </div>

            <!-- Stage -->
            <div class="stage-arc">
                <div class="stage-label">ESCENARIO</div>
            </div>

            <!-- Legend -->
            <div class="seat-legend">
                <div class="legend-item"><div class="seat-dot seat-dot--available standard"></div><span>Estándar</span></div>
                <div class="legend-item"><div class="seat-dot seat-dot--available premium"></div><span>Premium</span></div>
                <div class="legend-item"><div class="seat-dot seat-dot--available vip"></div><span>VIP</span></div>
                <div class="legend-item"><div class="seat-dot seat-dot--reserved"></div><span>Reservado</span></div>
                <div class="legend-item"><div class="seat-dot seat-dot--sold"></div><span>Vendido</span></div>
                <div class="legend-item"><div class="seat-dot seat-dot--selected"></div><span>Tu selección</span></div>
            </div>

            <!-- Seat Grid -->
            <div class="seat-grid" id="seatGrid"></div>

            <div class="seat-map-footer">
                <span id="selectionCount" class="selection-count">Ningún asiento seleccionado</span>
            </div>
        </div>

        <!-- RIGHT: Checkout Panel -->
        <div class="checkout-panel">
            <div class="checkout-card">
                <h3 class="checkout-title" id="checkoutTitle">
                    @(hasPending ? "Orden pendiente" : "Tu selección")
                </h3>

                <div class="selected-list" id="selectedList">
                    @if (hasPending)
                    {
                        @foreach (var item in pending!.Items)
                        {
                            <div class="selected-item">
                                <div>
                                    <div class="selected-item-label">💺 @item.SeatLabel</div>
                                    <div class="selected-item-type">@item.EventName</div>
                                </div>
                                <div class="selected-item-price">$@item.PricePaid.ToString("N0")</div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-selection">
                            <span>💺</span>
                            <p>Haz clic en los asientos disponibles para seleccionarlos</p>
                        </div>
                    }
                </div>

                <div class="checkout-summary" id="checkoutSummary" style="@(hasPending ? "display:block" : "display:none")">
                    <div class="summary-row"><span>Subtotal</span><span id="subtotalAmount">@(hasPending ? "$" + pending!.Total.ToString("N0") : "$0")</span></div>
                    <div class="summary-row summary-row--total"><span>Total</span><span id="totalAmount">@(hasPending ? "$" + pending!.Total.ToString("N0") : "$0")</span></div>
                </div>

                <div class="checkout-timer" id="reservationTimer" style="display:none">
                    <span class="timer-icon">⏱</span>
                    <span>Reservación expira en: <strong id="timerDisplay">05:00</strong></span>
                </div>

                @if (hasPending)
                {
                    <!-- Pending order: pay + cancel buttons shown right away -->
                    <button class="btn btn-primary btn-full" id="payBtn" style="margin-top:.75rem">
                        <span class="btn-label">💳 Confirmar y pagar</span>
                        <span class="btn-spinner hidden">⟳</span>
                    </button>
                    <button class="btn btn-ghost btn-full btn-sm" id="cancelBtn" style="margin-top:.5rem">
                        <span class="btn-label">✕ Cancelar orden</span>
                        <span class="btn-spinner hidden">⟳</span>
                    </button>
                    <button class="btn btn-primary btn-full" id="reserveBtn" disabled style="display:none; margin-top:.75rem">
                        <span class="btn-label">Reservar asientos</span>
                        <span class="btn-spinner hidden">⟳</span>
                    </button>
                }
                else
                {
                    <!-- Normal flow -->
                    <button class="btn btn-primary btn-full" id="reserveBtn" disabled style="margin-top:.75rem">
                        <span class="btn-label">@(isAuth ? "Reservar asientos" : "Selecciona asientos para continuar")</span>
                        <span class="btn-spinner hidden">⟳</span>
                    </button>
                    <button class="btn btn-primary btn-full" id="payBtn" style="display:none; margin-top:.75rem">
                        <span class="btn-label">Confirmar y pagar</span>
                        <span class="btn-spinner hidden">⟳</span>
                    </button>
                    <button class="btn btn-ghost btn-full btn-sm" id="cancelBtn" style="display:none; margin-top:.5rem">
                        Cancelar reserva
                    </button>
                }

                <!-- Login prompt for guest (shown when they click Reserve) -->
                <div id="loginPromptBanner" style="display:none; margin-top:.75rem">
                    <div class="login-prompt-box">
                        <p>Para completar tu compra necesitas iniciar sesión.</p>
                        <a asp-controller="Auth" asp-action="Login"
                           asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString"
                           class="btn btn-primary btn-full" style="margin-top:.6rem">
                            Iniciar sesión →
                        </a>
                        <p style="text-align:center;font-size:.78rem;color:var(--c-muted);margin-top:.6rem">
                            ¿No tienes cuenta?
                            <a asp-controller="Auth" asp-action="Register" class="link-accent">Regístrate gratis</a>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Payment method card -->
            <div class="payment-card" id="paymentCard" style="@(hasPending ? "display:block" : "display:none")">
                <h3 class="checkout-title">Método de pago</h3>
                <div class="payment-methods">
                    <label class="payment-option payment-option--active" id="pm-credit">
                        <input type="radio" name="paymentMethod" value="CreditCard" checked class="sr-only" />
                        <span class="pm-icon">💳</span><span>Tarjeta de crédito</span>
                    </label>
                    <label class="payment-option" id="pm-debit">
                        <input type="radio" name="paymentMethod" value="DebitCard" class="sr-only" />
                        <span class="pm-icon">🏦</span><span>Tarjeta débito</span>
                    </label>
                    <label class="payment-option" id="pm-pse">
                        <input type="radio" name="paymentMethod" value="PSE" class="sr-only" />
                        <span class="pm-icon">🔐</span><span>PSE</span>
                    </label>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Success Modal -->
<div class="modal-overlay" id="successModal" style="display:none">
    <div class="modal">
        <div class="modal-icon">🎉</div>
        <h2 class="modal-title">¡Compra exitosa!</h2>
        <p class="modal-sub">Tus tickets han sido generados. Encuéntralos en <strong>Mis Tickets</strong>.</p>
        <div class="modal-tickets" id="modalTickets"></div>
        <div class="modal-actions">
            <a asp-controller="Orders" asp-action="MyOrders" class="btn btn-primary">Ver mis tickets →</a>
            <a asp-controller="Events" asp-action="Index" class="btn btn-ghost">Seguir explorando</a>
        </div>
    </div>
</div>

@section Scripts {
<script>
// ── Constants injected from server ──────────────────────────────────
const SEATS_DATA   = @Html.Raw(seatsJson);
const SHOWTIME_ID  = @Model.Showtime.Id;
const BASE_PRICE   = @basePrice;
const IS_AUTH      = @Html.Raw(isAuth.ToString().ToLower());
const PENDING_ORDER = @Html.Raw(pendingJson);   // null or { id, total, items[] }

const PRICE_MAP  = { 0: BASE_PRICE, 1: BASE_PRICE * 1.5, 2: BASE_PRICE * 2 };
const TYPE_LABEL = { 0: 'Estándar', 1: 'Premium', 2: 'VIP' };
const TYPE_CLASS = { 0: 'standard', 1: 'premium', 2: 'vip' };

const STATUS_AVAILABLE = 0;
const STATUS_RESERVED  = 1;
const STATUS_SOLD      = 2;
</script>
<script src="~/js/seats.js" asp-append-version="true"></script>

<script>
// Payment option highlight on click
document.querySelectorAll('.payment-option').forEach(label => {
    label.addEventListener('click', () => {
        document.querySelectorAll('.payment-option').forEach(l => l.classList.remove('payment-option--active'));
        label.classList.add('payment-option--active');
    });
});
</script>
}
