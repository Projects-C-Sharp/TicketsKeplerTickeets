@{
    ViewData["Title"] = "Correo enviado";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="auth-card__header">
        <a href="/" class="auth-brand">◈ KEPLER</a>
        <div class="success-icon">✉️</div>
        <h1 class="auth-title">Revisa tu correo</h1>
        <p class="auth-sub">
            Si el correo está registrado, te enviamos un mensaje de confirmación.<br/><br/>
            Haz clic en el botón del correo para confirmar que eres tú. Después recibirás tu nueva contraseña en un segundo correo.
        </p>
        <p class="auth-sub" style="font-size:0.82rem; opacity:0.7; margin-top:0.5rem;">El enlace expira en 15 minutos.</p>
    </div>
    <div class="auth-footer">
        <a asp-controller="Auth" asp-action="Login" class="btn btn-outline btn-full">Volver a iniciar sesión</a>
    </div>
</div>
