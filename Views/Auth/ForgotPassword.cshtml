@model TicketsKeplerTickets.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="auth-card__header">
        <a href="/" class="auth-brand">◈ KEPLER</a>
        <h1 class="auth-title">¿Olvidaste tu contraseña?</h1>
        <p class="auth-sub">Te enviaremos un enlace para restablecerla</p>
    </div>

    <form asp-controller="Auth" asp-action="ForgotPassword" method="post" class="auth-form">
        <div asp-validation-summary="All" class="form-errors"></div>

        <div class="form-group">
            <label asp-for="Email" class="form-label">Correo electrónico</label>
            <div class="input-wrapper">
                <span class="input-icon">✉</span>
                <input asp-for="Email" class="form-input" placeholder="tu@correo.com" autocomplete="email" />
            </div>
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-full">Enviar enlace de recuperación</button>
    </form>

    <div class="auth-footer">
        <a asp-controller="Auth" asp-action="Login" class="link-accent">← Volver a iniciar sesión</a>
    </div>
</div>
