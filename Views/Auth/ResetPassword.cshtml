@model TicketsKeplerTickets.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Nueva contraseña";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="auth-card__header">
        <a href="/" class="auth-brand">◈ KEPLER</a>
        <h1 class="auth-title">Nueva contraseña</h1>
        <p class="auth-sub">Elige una contraseña segura para tu cuenta</p>
    </div>

    <form asp-controller="Auth" asp-action="ResetPassword" method="post" class="auth-form">
        <div asp-validation-summary="All" class="form-errors"></div>
        <input asp-for="Email" type="hidden" />
        <input asp-for="Token" type="hidden" />

        <div class="form-group">
            <label asp-for="NewPassword" class="form-label">Nueva contraseña</label>
            <div class="input-wrapper">
                <span class="input-icon">🔒</span>
                <input asp-for="NewPassword" class="form-input" type="password" placeholder="Mínimo 6 caracteres" id="pwd1" />
                <button type="button" class="toggle-password" onclick="togglePwd('pwd1',this)" tabindex="-1">👁</button>
            </div>
            <span asp-validation-for="NewPassword" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="ConfirmPassword" class="form-label">Confirmar contraseña</label>
            <div class="input-wrapper">
                <span class="input-icon">🔒</span>
                <input asp-for="ConfirmPassword" class="form-input" type="password" placeholder="Repite tu contraseña" id="pwd2" />
                <button type="button" class="toggle-password" onclick="togglePwd('pwd2',this)" tabindex="-1">👁</button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-full">Guardar nueva contraseña</button>
    </form>
</div>

@section Scripts {
<script>
function togglePwd(id, btn) {
    const input = document.getElementById(id);
    if (input.type === 'password') { input.type = 'text'; btn.textContent = '🙈'; }
    else { input.type = 'password'; btn.textContent = '👁'; }
}
</script>
}
